<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the two permissions the offline-first app genuinely needs: the ML Kit translation
         model is downloaded over the network on first use, and connectivity is probed for the
         AI/API "test connection" action. No camera, microphone, storage or billing permissions:
         the camera is launched through a FileProvider intent, speech input through the system
         recogniser, and there is no advertising, purchase or cloud-sync SDK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Offdic"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Receive selected/shared text from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="@string/ai_settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LanguageToolsActivity"
            android:exported="false"
            android:label="@string/tools_title"
            android:parentActivityName=".MainActivity" />

        <!-- Camera capture for OCR is written to the app cache and shared through this provider,
             so the camera app never needs a storage permission. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

        <receiver
            android:name=".DailyWordWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_word_widget_info" />
        </receiver>
    </application>

</manifest>
