<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws its own chrome in code (MainActivity is a plain android.app.Activity), so the
         platform Material theme is enough; no AppCompat/Material Components dependency is needed. -->
    <style name="Theme.Offdic" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fdWhite</item>
        <item name="android:statusBarColor">@color/fdPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
